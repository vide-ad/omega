# Bearer tokens (spec §6.1). Generate with: openssl rand -hex 32
OMEGA_TOKEN_WRITE=change-me-write
OMEGA_TOKEN_READ=change-me-read
# SQLite file path (created on first run)
OMEGA_DB_PATH=./data/omega.db
# Port
PORT=8787
# Directory of the built PWA to serve at / (optional)
OMEGA_STATIC_DIR=../web/dist
